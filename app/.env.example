# Names only. Local: app/.env.local (gitignored). Hosted: Vercel env vars.
# Public (browser) — no secrets here.
NEXT_PUBLIC_RPC_URL=                 # devnet RPC; falls back to https://api.devnet.solana.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # read-only via RLS
NEXT_PUBLIC_PROGRAM_ID=              # optional override; default 4bwTwLAZqPMLSbdvQQ9UrePJiRBUKgiA8TKV3ydo4tqe
NEXT_PUBLIC_LEND_ALT=                # Jupiter Lend address lookup table (from the P lane)
NEXT_PUBLIC_QUICK_PLANS_ENABLED=1
NEXT_PUBLIC_MAKER_BOTS=              # comma-separated maker-1,maker-2 pubkeys (labels on /auctions)
# Server only
WORKER_URL=                          # https://… of the ECS worker
WORKER_SHARED_SECRET=                # sent as Authorization: Bearer
HELIUS_RPC_URL=                      # used by the Blink POST route (server)
